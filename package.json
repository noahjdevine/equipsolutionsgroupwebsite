    "eval:yardley": "node --env-file=.env --import tsx scripts/yardley-eval.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.18",
    "ai": "^7.0.154",
    "astro": "^7.4.5",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@vercel/nft": {
      "glob": "14.0.3"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "@vercel/cli-config": {
      "zod": "$zod"
