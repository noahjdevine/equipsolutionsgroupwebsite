---
// aria-current is resolved at build time. It was previously set by site.js from
// location.pathname, which cannot work once URLs lose their .html extension.
const here = Astro.url.pathname;
const current = (path: string) => (path === here ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <circle cx="50" cy="50" r="46" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <line x1="70" y1="24" x2="30" y2="76" stroke="currentColor" stroke-width="1.6"/>
        <text x="30" y="52" font-family="Barlow Condensed, sans-serif" font-size="40" font-weight="500" fill="currentColor" text-anchor="middle">E</text>
        <text x="68" y="76" font-family="Barlow Condensed, sans-serif" font-size="40" font-weight="500" fill="currentColor" text-anchor="middle">S</text>
      </svg>
      <span>
        <span class="brand-name">Equip Solutions Group</span><br>
        <span class="brand-sub">Equipment &middot; Parts &middot; Solutions</span>
      </span>
    </a>

    <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="primary-nav">Menu</button>

    <nav class="nav" id="primary-nav" data-nav aria-label="Primary">
      <ul class="nav-list">
        <li class="nav-item">
          <a class="nav-link" href="/starmix/" aria-current={current('/starmix/')}>StarMix</a>
        </li>
        <li class="nav-item has-dropdown">
          <button class="nav-trigger" aria-expanded="false">Parts <span class="caret"></span></button>
          <ul class="dropdown">
            <li><a href="/parts/#starmix" aria-current={current('/parts/')}>StarMix / SMI Parts<span class="dd-note">Genuine and cross-compatible components</span></a></li>
            <li><a href="/parts/#request" aria-current={current('/parts/')}>Request Parts</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/sourcing/" aria-current={current('/sourcing/')}>Sourcing</a>
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/about/" aria-current={current('/about/')}>About</a>
        </li>
      </ul>
      <a class="nav-cta" href="/contact/" aria-current={current('/contact/')}>Request a Quote</a>
    </nav>
  </div>
</header>
