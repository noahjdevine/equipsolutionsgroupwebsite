---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { models, series } from '../data/models';
import ApplicationsGrid from '../components/ApplicationsGrid.astro';
---

<BaseLayout
  title="StarMix on-site concrete plants | Equip Solutions Group"
  description="Independent US representative for StarMix plants. Specs, genuine SMI parts, operator training, and bilingual support. Se habla español.">

  <section class="page-hero">
    <div class="wrap page-hero-inner">
      <p class="eyebrow">Manufacturer line &middot; Se habla espa&ntilde;ol</p>
      <h1>StarMix Volumetric Concrete Plants</h1>
      <p>Carry the materials dry and mix only what the pour actually needs. Batch, measure, mix and dispense from one unit &mdash; on site, on demand, with no short loads and nothing hauled back.</p>
      <div class="btn-row">
        <a class="btn" href="/contact/">Get a plant quote</a>
        <a class="btn btn-ghost" href="/parts/#starmix">SMI parts</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="split">
        <div>
          <p class="eyebrow">How volumetric differs</p>
          <h2 style="font-size:var(--step-3);text-transform:uppercase;">The clock does not start until you pour</h2>
          <p class="lede" style="margin-top:1rem;">A drum truck leaves the plant with concrete already mixing and a hard deadline attached. A volumetric plant carries sand, stone, cement, water and admixture in separate compartments and mixes continuously at the discharge. Nothing sets on the way to site.</p>
          <ul class="checks" style="margin-top:1.5rem;">
            <li><strong>Pour what you need.</strong> Order by the job, not by the truckload. No paying for waste, no short-load fees.</li>
            <li><strong>Change the mix mid-load.</strong> Different strengths or slumps from the same load, adjusted in minutes.</li>
            <li><strong>No return concrete.</strong> Unused material stays dry in the bins and goes back to the yard as inventory.</li>
            <li><strong>Reload while running.</strong> The cascade feed lets you top up hoppers during production without stopping the pour.</li>
            <li><strong>Small wash-down.</strong> Only the mixing section contacts wet concrete, so cleanup uses a fraction of the water.</li>
          </ul>
        </div>
        <div class="ph ph--tall">Photo &mdash; volumetric plant discharging on site<br>Recommended 900&times;1200</div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Representative models</p>
        <h2>Output sized to the work</h2>
        <p>Figures below are manufacturer-published for representative units. Configurations vary by chassis, market and options &mdash; every quote confirms the exact build.</p>
      </div>

      <div class="plate-grid plate-grid--3">
        {models.map((model) => (
          <div class="plate">
            <div class="plate-code">Series {model.series}</div>
            <h3>{model.name}</h3>
            <p>{series[model.series].blurb}</p>
            <dl class="dl">
              <dt>Bin capacity</dt>
              <dd>{model.binCapacityYd3 != null ? `${model.binCapacityYd3} yd³` : 'Not published'}</dd>
              <dt>Production rate</dt>
              <dd>{model.productionYd3Hr != null ? `Up to ${model.productionYd3Hr} yd³/hr` : 'Not published'}</dd>
              {model.components?.cementHopper && (
                <>
                  <dt>Cement hopper</dt>
                  <dd>{model.components.cementHopper}</dd>
                </>
              )}
              {model.components?.waterTank && (
                <>
                  <dt>Water tank</dt>
                  <dd>{model.components.waterTank}</dd>
                </>
              )}
              {model.components?.notes?.map((note) => (
                <>
                  <dt>Also</dt>
                  <dd>{note}</dd>
                </>
              ))}
            </dl>
          </div>
        ))}
      </div>
      <p class="small muted" style="margin-top:1rem;">Figures are manufacturer-published on the StarMix US pages. Configurations vary by chassis, market and options &mdash; every quote confirms the exact build. 740 K has no published bin or production figures; do not treat a blank as a zero.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Where it earns</p>
        <h2>Jobs that punish ready-mix</h2>
      </div>
      <ApplicationsGrid />
    </div>
  </section>

  <section class="section section--dark on-dark">
    <div class="wrap">
      <div class="split split--narrow">
        <div>
          <p class="eyebrow">After delivery</p>
          <h2 style="font-size:var(--step-3);text-transform:uppercase;">A plant is only as good as the operator</h2>
          <p class="lede" style="margin-top:1rem;">Volumetric equipment rewards a trained operator and punishes a guessing one. Calibration, gate settings and flowmeter positions are what stand between a good pour and a rejected one.</p>
        </div>
        <div>
          <ul class="checks">
            <li><strong>Operator training.</strong> Batching, calibration, mix design and concrete technology &mdash; not just which lever does what.</li>
            <li><strong>Startup checks.</strong> Gates calibrated to the mix design, flowmeters set, cement hopper clutch selected, water and admixture switched to automatic.</li>
            <li><strong>Maintenance and rebuild.</strong> Full unit restoration and service through the manufacturer network.</li>
            <li><strong>Genuine SMI parts.</strong> Stocked components engineered for the unit, many cross-compatible with other volumetric brands.</li>
            <li><strong>Bilingual support.</strong> English and Spanish, on the phone and on site.</li>
          </ul>
          <div class="btn-row">
            <a class="btn" href="/parts/#starmix">Browse parts categories</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Run the numbers on your own pours"
    body="Tell me your typical load size, how far you haul, and what you throw away in a month. That comparison usually answers the question faster than a brochure does.">
    <a class="btn" href="/contact/">Request a Quote</a>
    <a class="btn btn-ghost" href="tel:+15157200800">Call +1 515 720 0800</a>
  </CtaBand>

</BaseLayout>
