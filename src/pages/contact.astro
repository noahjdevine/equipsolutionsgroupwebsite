---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import QuoteForm from '../components/QuoteForm.astro';
---

<BaseLayout
  title="Contact & Quote Request | Equip Solutions Group"
  description="Request a quote for a StarMix plant, SMI parts, or equipment sourcing. Call +1 515 720 0800 or send the details.">

  <section class="page-hero">
    <div class="wrap page-hero-inner">
      <p class="eyebrow">Contact</p>
      <h1>Request a Quote</h1>
      <p>A StarMix plant, a part, or a sourcing request &mdash; the more detail you send, the faster a real number comes back. If a machine is down, call instead.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="split split--narrow">
        <div>
          <p class="eyebrow">Direct</p>
          <ul class="contact-lines">
            <li>
              <div class="cl-label">Phone &amp; text</div>
              <div class="cl-value"><a href="tel:+15157200800">+1 515 720 0800</a></div>
            </li>
            <li>
              <div class="cl-label">WhatsApp</div>
              <div class="cl-value"><WhatsAppLink /></div>
              <p class="spanish-note">Se habla espa&ntilde;ol. Sales, training, and support in Spanish.</p>
            </li>
            <li>
              <div class="cl-label">Email</div>
              <div class="cl-value" style="font-size:1.125rem;"><a href="mailto:paul@equipsolutionsgroup.com">paul@equipsolutionsgroup.com</a></div>
            </li>
            <li>
              <div class="cl-label">Lines represented</div>
              <div class="cl-value" style="font-size:1.125rem;">StarMix Industries &middot; Sourcing desk</div>
            </li>
          </ul>

          <div class="plate" style="margin-top:2rem;">
            <div class="plate-code">Fastest route</div>
            <h3 style="font-size:1.5rem;">Down machine?</h3>
            <p>Call, text, or WhatsApp a photo. Downtime requests go to the front of the queue &mdash; do not wait on a form response.</p>
          </div>
        </div>

        <div>
          <p class="eyebrow">Send the details</p>
          <QuoteForm />
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Prefer to just talk?"
    body="Most of this gets settled faster on the phone than in writing.">
    <a class="btn" href="tel:+15157200800">Call +1 515 720 0800</a>
  </CtaBand>

</BaseLayout>
