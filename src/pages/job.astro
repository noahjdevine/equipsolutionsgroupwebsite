---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import { PREFERRED_CONTACT, PREFERRED_LANGUAGE } from '../data/lead';
---
<BaseLayout title="Yardley — work out your mixer fit | Equip Solutions Group" description="Talk through the work, compare provisional StarMix options and prepare a job brief for Paul. No yardage? Start with what you know.">
  <section class="yardley" data-yardley>
    <div class="wrap">
      <div class="yardley-intro">
        <div class="yardley-identity"><span class="yardley-mark" aria-hidden="true">Y<span>/</span></span><p class="yardley-label">Yardley <span data-ai-mode>AI mixer guide</span></p></div>
        <h1>Let’s talk concrete.</h1>
        <p>Tell me what you build. We’ll work out the details, compare a starting point, and get your questions ready for Paul.</p>
        <div class="yardley-intro-meta"><span>No model numbers needed.</span><a href="tel:+15157200800">Rather talk? Call Paul ↗</a></div>
      </div>
      <noscript><p class="yardley-notice">Turn on JavaScript for the guided questions, or <a href="/contact/">request a quote</a> and tell Paul what you know.</p></noscript>
      <div class="yardley-workspace" data-workspace hidden>
        <div class="yardley-conversation">
          <div class="yardley-panel-head"><span class="yardley-label">The job comes first</span><div><a href="#yardley-message" class="yardley-text-button" data-type>Type instead ↓</a><button type="button" class="yardley-text-button" data-back disabled>Back</button><button type="button" class="yardley-text-button" data-reset>Start over</button></div></div>
          <div class="yardley-reset" data-reset-confirm hidden><p>Clear this job and conversation? This cannot be undone.</p><button type="button" class="yardley-text-button" data-reset-yes>Yes, start fresh</button><button type="button" class="yardley-text-button" data-reset-no>Keep this job</button></div>
          <div class="yardley-exchange" data-exchange aria-label="Recent conversation"></div>
          <div class="yardley-question" data-question></div>
          <form class="yardley-composer" data-composer>
            <label for="yardley-message">Tell me in your own words</label>
            <div class="yardley-composer-row"><textarea id="yardley-message" name="message" rows="2" maxlength="2000" placeholder="“I’m starting with driveways and patios…”" aria-describedby="yardley-text-help"></textarea><button class="btn" type="submit">Send <span aria-hidden="true">↗</span></button></div>
            <div class="yardley-reply-actions"><button class="yardley-text-button" type="button" data-cancel-reply hidden>Cancel reply</button><button class="yardley-text-button" type="button" data-retry-reply hidden>Retry AI reply</button></div>
            <p id="yardley-text-help">Ask a question or describe the work. AI uses your messages and job details to help with this conversation. Enter sends; Shift + Enter adds a line.</p>
            <p data-connection-note>Confirm suggested details before they affect the comparison. Guided choices are always available.</p>
          </form>
          <p class="yardley-status" data-status role="status" aria-live="polite" aria-atomic="true"></p>
        </div>
        <aside class="yardley-sidebar" aria-label="Your job summary">
          <details class="yardley-summary" data-summary open>
            <summary><span>Your job, so far</span><span class="yardley-summary-toggle">Show / hide</span></summary>
            <div class="yardley-summary-body"><p class="small muted">Change any detail. Unsure is a useful answer.</p><dl data-summary-rows></dl><label for="yardley-notes">Notes & questions for Paul</label><textarea id="yardley-notes" rows="3" maxlength="2000" data-notes placeholder="Anything else Paul should know?"></textarea><p class="small muted">Kept on this page until you leave or start over.</p><button class="btn" type="button" data-review>Review my job brief</button></div>
          </details>
          <p class="yardley-paul">The final call is Paul’s.<br><a href="tel:+15157200800">+1 515 720 0800</a><br><span>Se habla español.</span></p>
        </aside>
      </div>
      <section class="yardley-results" data-results hidden aria-labelledby="yardley-results-title">
        <div class="yardley-section-head"><div><p class="eyebrow">The starting point</p><h2 id="yardley-results-title" tabindex="-1">Fit the machine to the work.</h2></div><p>Published figures help narrow the field. Paul confirms the machine and configuration on the written quote.</p></div>
        <p class="yardley-fit-status" data-fit-status></p><div data-reasons></div><div class="yardley-models" data-models></div><p class="yardley-comparison" data-comparison hidden></p><div class="yardley-qualifications" data-qualifications></div>
      </section>
      <section class="yardley-review" data-review-panel hidden aria-labelledby="yardley-review-title">
        <div class="yardley-section-head"><div><p class="eyebrow">Ready for a conversation</p><h2 id="yardley-review-title" tabindex="-1">Here’s what Paul should know.</h2></div><button class="yardley-text-button" type="button" data-return>Edit my answers ↑</button></div>
        <div class="yardley-review-grid"><div><dl data-review-rows></dl><div class="yardley-review-notes"><h3>Your notes & questions</h3><p data-review-notes></p></div><div data-review-questions></div><details class="yardley-email-preview"><summary>Exact email to Paul</summary><p data-email-preview-help>Add your contact details to preview the complete email.</p><pre data-email-preview hidden></pre></details></div>
          <div class="yardley-review-actions"><p class="yardley-label">How should Paul reach you?</p><p>Review the brief and add your contact details. Send it when you’re ready—even if some answers are still open.</p>
            <form data-handoff-form novalidate>
              <p class="hp" aria-hidden="true"><label for="yardley-website">Website</label><input id="yardley-website" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" /></p>
              <fieldset data-contact-fields>
                <legend class="sr-only">Contact details for this brief</legend>
                <div class="yardley-field"><label for="yardley-contact-name">Name</label><input id="yardley-contact-name" name="name" autocomplete="name" maxlength="100" required /><p class="field-error" data-handoff-error="contact.name" hidden></p></div>
                <div class="yardley-field"><label for="yardley-contact-company">Company (optional)</label><input id="yardley-contact-company" name="company" autocomplete="organization" maxlength="160" /><p class="field-error" data-handoff-error="contact.company" hidden></p></div>
                <div class="yardley-field"><label for="yardley-preferred-contact">Preferred contact</label><select id="yardley-preferred-contact" name="preferredContact">{PREFERRED_CONTACT.map((entry) => <option value={entry.value} selected={entry.value === 'email'}>{entry.label}</option>)}</select><p class="field-error" data-handoff-error="contact.preferredContact" hidden></p></div>
                <div class="yardley-field"><label for="yardley-contact-email">Email <span data-email-optional></span></label><input id="yardley-contact-email" name="email" type="email" autocomplete="email" maxlength="254" /><p class="field-error" data-handoff-error="contact.email" hidden></p></div>
                <div class="yardley-field"><label for="yardley-contact-phone">Phone <span data-phone-optional>(optional)</span></label><input id="yardley-contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /><p class="field-error" data-handoff-error="contact.phone" hidden></p></div>
                <div class="yardley-field"><label for="yardley-contact-state">State (optional)</label><input id="yardley-contact-state" name="state" autocomplete="address-level1" maxlength="80" /><p class="field-error" data-handoff-error="contact.state" hidden></p></div>
                <div class="yardley-field"><label for="yardley-preferred-language">Preferred language</label><select id="yardley-preferred-language" name="preferredLanguage">{PREFERRED_LANGUAGE.map((entry) => <option value={entry.value}>{entry.label}</option>)}</select></div>
              </fieldset>
              <p class="small" data-handoff-state>Your brief has not been sent.</p>
              <p class="yardley-status" data-handoff-status role="status" aria-live="polite" aria-atomic="true"></p>
              <button class="btn" type="submit" data-send-brief>Send my reviewed brief</button>
              <p class="small muted">Sends the contact details and reviewed brief shown here to paul@equipsolutionsgroup.com.</p>
            </form>
            <button class="btn btn-ghost" type="button" data-copy>Copy my job brief</button><p class="small" data-copy-status role="status" aria-live="polite"></p><a class="card-link" href="tel:+15157200800">Call +1 515 720 0800 ↗</a>
          </div>
        </div>
      </section>
      <section class="yardley-receipt" data-receipt-panel hidden aria-labelledby="yardley-receipt-title">
        <p class="eyebrow">Your submitted snapshot</p><h2 id="yardley-receipt-title" tabindex="-1">Your brief is submitted.</h2>
        <p>The email service accepted this brief for sending to Paul. This receipt does not confirm inbox delivery.</p>
        <p class="small" data-receipt-reference></p><details><summary>Read the submitted brief</summary><pre data-receipt-text></pre></details>
        <p data-revision-note>Changes to your answers will start a revised inquiry; this submitted snapshot stays the same.</p><button class="yardley-text-button" type="button" data-revise>Prepare a revised inquiry ↑</button>
      </section>
    </div>
  </section>
  <CtaBand heading="Some jobs are easier to talk through." body="Bring what you know. Paul can help with the rest."><a class="btn" href="tel:+15157200800">Call +1 515 720 0800</a><a class="btn btn-ghost" href="/contact/">Request a quote</a></CtaBand>
</BaseLayout>
<script>
  import { startGuide } from '../scripts/job';
  startGuide();
</script>
