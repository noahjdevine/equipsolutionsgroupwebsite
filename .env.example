# Server-only. Never prefix with PUBLIC_. Copy to .env for astro dev.
RESEND_API_KEY=

# Yardley server-only conversation. Verified from the live catalog November 1, 2026.
# Use ONE dedicated key across environments so its actual account budget covers all usage.
# Configure a $20 MONTHLY key budget in Gateway, verify it and publish the scoped
# /api/guide rate-limit rule before setting YARDLEY_AI_ENABLED=true.
# These settings identify verified controls; they do not create a budget or a WAF rule.
# No OIDC/direct-provider/alternate-model fallback may bypass this key budget.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-6-luna
YARDLEY_AI_ENABLED=false
YARDLEY_BUDGET_KEY_ID=
YARDLEY_RATE_LIMIT_ID=
