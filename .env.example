# Server-only. Never prefix with PUBLIC_. Copy to .env for astro dev.
RESEND_API_KEY=

# Vercel AI Gateway — closing paragraph on /job/ only.
# AI_GATEWAY_MODEL is a provider/model id from https://ai-gateway.vercel.sh/v1/models
# If either value is empty, /api/guide returns the scripted note.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
